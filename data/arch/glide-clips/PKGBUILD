pkgname=glide-clips
pkgver=0.1.r35.g64665c8
pkgrel=1
pkgdesc="Video player of the Glide desktop"
arch=(x86_64)
url="https://github.com/Glide-Desktop/glide-clips"
license=(GPL-3.0-or-later)
depends=(
    glibc gcc-libs libglvnd vulkan-icd-loader wayland libxkbcommon hicolor-icon-theme
    glide-configd dbus xdg-utils
    gstreamer gst-plugins-base gst-plugins-base-libs gst-plugins-good gst-plugins-bad gst-plugins-bad-libs
    gst-libav gst-plugins-ugly gst-plugin-va
    tesseract tesseract-data-eng tesseract-data-ukr
)
optdepends=(
    'intel-media-driver: hardware video decoding on Intel graphics'
    'libva-mesa-driver: hardware video decoding on AMD graphics'
)
makedepends=(git cargo pkgconf)
options=(!lto !debug)
_git="${GLIDE_GIT:-https://github.com/Glide-Desktop}"
_target="${GLIDE_CARGO_TARGET:-target}"
source=("$pkgname::git+$_git/glide-clips")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    if tag="$(git describe --long --tags --abbrev=7 2>/dev/null)"; then
        printf '%s' "$tag" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$_target"
    cargo build --frozen --release -p glide-clips
}

package() {
    cd "$pkgname"
    install -Dm755 $_target/release/glide-clips "$pkgdir/usr/bin/glide-clips"
    install -Dm644 data/glide-clips.desktop "$pkgdir/usr/share/applications/glide-clips.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
